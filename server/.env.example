# Read directly by Node and Express (error verbosity, view caching) — deliberately not
# part of the zod-validated config in src/config.ts, which only holds values our own code
# reads.
NODE_ENV=development

PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/search_engine
# Optional. Only the crawler needs Redis (frontier + robots cache), so leave this unset
# when hosting the API — it boots and reports healthy without it. Set it locally when
# running `docker compose up` / the crawl job.
REDIS_URL=redis://localhost:6379
