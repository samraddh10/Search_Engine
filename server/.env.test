# Environment for `npm test`. Committed on purpose: these are local-only Docker
# credentials, same as .env.example, and every developer needs the identical test setup.
#
# The database name MUST end in _test — test/globalSetup.ts refuses to run otherwise, so a
# mistyped URL can never truncate your development data.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/search_engine_test

# REDIS_URL is deliberately absent. The API has no Redis in production (see the hosting
# model in docs/project-plan.md), so "no Redis" is the configuration worth testing by
# default. The tests that need a configured client set it themselves via vi.stubEnv.
